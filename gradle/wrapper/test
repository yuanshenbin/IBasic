  }

  normalBorderRadius(value: Length | BorderRadiuses | LocalizedBorderRadiuses): T {
    this.normalBorderRadius_ = value;
    return this as Object as T;
  }

  pressedBorderRadius(value: Length | BorderRadiuses | LocalizedBorderRadiuses): T {
    this.pressedBorderRadius_ = value;
