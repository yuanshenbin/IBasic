/**
 * 4种状态下的style
 normal 正常背景颜色
 pressed 按背景颜色
 disabled 禁用背景颜色
 selected 已选择背景颜色
 */
export class ViewModifier<T extends ViewModifier<T>> implements AttributeModifier<ButtonAttribute | TextAttribute | ColumnAttribute | RowAttribute | FlexAttribute> {
  protected buttonType_: ButtonType = ButtonType.Normal;
  protected normalBackgroundColor_?: ResourceColor;
  protected pressedBackgroundColor_?: ResourceColor;
  protected disabledBackgroundColor_?: ResourceColor;
  protected selectedBackgroundColor_?: ResourceColor;
  protected normalBorderRadius_?: Length | BorderRadiuses | LocalizedBorderRadiuses;
  protected pressedBorderRadius_?: Length | BorderRadiuses | LocalizedBorderRadiuses;
  protected disabledBorderRadius_?: Length | BorderRadiuses | LocalizedBorderRadiuses;
  protected selectedBorderRadius_?: Length | BorderRadiuses | LocalizedBorderRadiuses;
  protected borderRadius_?: Length | BorderRadiuses | LocalizedBorderRadiuses;
  protected normalBorderWidth_?: Length | EdgeWidths | LocalizedEdgeWidths;
  protected pressedBorderWidth_?: Length | EdgeWidths | LocalizedEdgeWidths;
  protected disabledBorderWidth_?: Length | EdgeWidths | LocalizedEdgeWidths;
  protected selectedBorderWidth_?: Length | EdgeWidths | LocalizedEdgeWidths;
  protected normalBorderColor_?: ResourceColor | EdgeColors | LocalizedEdgeColors;
  protected pressedBorderColor_?: ResourceColor | EdgeColors | LocalizedEdgeColors;
  protected disabledBorderColor_?: ResourceColor | EdgeColors | LocalizedEdgeColors;
  protected selectedBorderColor_?: ResourceColor | EdgeColors | LocalizedEdgeColors;
  protected normalFontColor_?: ResourceColor;
  protected pressedFontColor_?: ResourceColor;
  protected disabledFontColor_?: ResourceColor;
  protected selectedFontColor_?: ResourceColor;
  protected normalFontSize_?: Length;
  protected pressedFontSize_?: Length;
  protected disabledFontSize_?: Length;
  protected selectedFontSize_?: Length;

  /**
   * 组件普通状态时的样式。
   * @param instance
   */
  applyNormalAttribute(instance: ButtonAttribute | TextAttribute | ColumnAttribute | RowAttribute | FlexAttribute): void {
    instance.backgroundColor(this.normalBackgroundColor_);
    instance.borderRadius(this.borderRadius_ || this.normalBorderRadius_);
    instance.borderWidth(this.normalBorderWidth_);
    instance.borderColor(this.normalBorderColor_);

  }

  /**
   * 组件按压状态的样式。
   * @param instance
   */
  applyPressedAttribute(instance: ButtonAttribute | TextAttribute | ColumnAttribute | RowAttribute | FlexAttribute): void {
    instance.backgroundColor(this.pressedBackgroundColor_);
    instance.borderRadius(this.borderRadius_ || this.pressedBorderRadius_);
    instance.borderWidth(this.pressedBorderWidth_);
    instance.borderColor(this.pressedBorderColor_);
  }

  /**
   * 组件获焦状态的样式
   * @param instance
   */
  applyFocusedAttribute(instance: ButtonAttribute | TextAttribute | ColumnAttribute | RowAttribute | FlexAttribute): void {
    // 如果需要添加获焦状态的样式，可以在这里实现
    // instance.type(this.buttonType);
  }

  /**
   * 组件禁用状态的样式
   * @param instance
   */
  applyDisabledAttribute(instance: ButtonAttribute | TextAttribute | ColumnAttribute | RowAttribute | FlexAttribute): void {
    instance.backgroundColor(this.disabledBackgroundColor_);
    instance.borderRadius(this.borderRadius_ || this.disabledBorderRadius_);
    instance.borderWidth(this.disabledBorderWidth_);
    instance.borderColor(this.disabledBorderColor_);

  }

  /**
   * 组件选中状态的样式
   * @param instance
   */
  applySelectedAttribute(instance: ButtonAttribute | TextAttribute | ColumnAttribute | RowAttribute | FlexAttribute): void {
    instance.backgroundColor(this.selectedBackgroundColor_);
    instance.borderRadius(this.borderRadius_ || this.selectedBorderRadius_);
    instance.borderWidth(this.selectedBorderWidth_);
    instance.borderColor(this.selectedBorderColor_);

  }


  buttonType(value: ButtonType): T {
    this.buttonType_ = value;
    return this as Object as T;
  }

  normalBackgroundColor(value: ResourceColor): T {
    this.normalBackgroundColor_ = value;
    return this as Object as T;
  }

  pressedBackgroundColor(value: ResourceColor): T {
    this.pressedBackgroundColor_ = value;
    return this as Object as T;
  }

  disabledBackgroundColor(value: ResourceColor): T {
